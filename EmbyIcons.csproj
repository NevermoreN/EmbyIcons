<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<OutputType>Library</OutputType>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>

		<Version>5.61.1.7</Version>
		<AssemblyVersion>5.61.1.7</AssemblyVersion>
		<FileVersion>5.61.1.7</FileVersion>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<DefaultItemExcludes>$(DefaultItemExcludes);tools\**;native\**</DefaultItemExcludes>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="AssemblyInfo.cs;Configuration\PluginOptions.cs;Api\ApiRoutes.cs;Interop\**\*.cs;Host\**\*.cs" />
	</ItemGroup>
	<PropertyGroup>
		<NativeBundlePath Condition="'$(NativeBundlePath)' == ''">$(MSBuildProjectDirectory)/native/artifacts/runtime-linux-x64.zip</NativeBundlePath>
	</PropertyGroup>
	<ItemGroup>
		<EmbeddedResource Include="$(NativeBundlePath)" LogicalName="EmbyIcons.Native.linux-x64.zip" />
	</ItemGroup>
	<Target Name="RequireNativeBundle" BeforeTargets="PrepareForBuild">
		<Error Condition="!Exists('$(NativeBundlePath)')" Text="Build the native runtime bundle first; see native/embyicons-core/README.md." />
	</Target>

	<ItemGroup>
		<EmbeddedResource Include="EmbyIconsConfiguration.html" />
		<EmbeddedResource Include="EmbyIconsConfiguration.js" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.Utils.js" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.Dom.js" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.DomCache.js" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.Events.js" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.DataLoader.js" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.UIHandlers.js" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.ProfileUI.js" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.Profile.js" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.Scans.js" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.Api.js" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.SafeZones.js" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.Settings.html" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.IconLayout.html" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.Advanced.html" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.IconManager.html" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.Troubleshooter.html" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.Readme.html" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.AddProfileTemplate.html" />
		<EmbeddedResource Include="Configuration\EmbyIconsConfiguration.RenameProfileTemplate.html" />
		<EmbeddedResource Include="Images\logo.png" />
		<EmbeddedResource Include="Images\preview.png" />
		<EmbeddedResource Include="Images\tag.png" />
		<EmbeddedResource Include="plugin.js" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MediaBrowser.Common" Version="4.9.1.90" PrivateAssets="all" ExcludeAssets="runtime" />
		<PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90" PrivateAssets="all" ExcludeAssets="runtime" />
		<PackageReference Include="System.Memory" Version="4.6.3" PrivateAssets="all" ExcludeAssets="runtime" />
		<PackageReference Include="System.Text.Json" Version="6.0.10" PrivateAssets="all" ExcludeAssets="runtime" />
	</ItemGroup>

</Project>
